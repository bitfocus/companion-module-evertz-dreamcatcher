{
	"name": "companion-module-evertz-dreamcatcher",
	"version": "1.1.5",
	"description": "Evertz DreamCatcher Companion module",
	"license": "MIT",
	"main": "dist/main.js",
	"scripts": {
		"build": "sh -c 'tsc && mkdir -p pkg && cp -R dist/* pkg/ && cp -R companion pkg/ && cp README.md LICENSE pkg/' --",
		"package": "companion-module-build",
		"format": "prettier -w ."
	},
	"files": [
		"pkg",
		"companion",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"@companion-module/base": "^1.12.0"
	},
	"devDependencies": {
		"@companion-module/tools": "2.7.2",
		"@types/node": "^20.0.0",
		"prettier": "^3.8.3",
		"typescript": "^5.4.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json"
}
