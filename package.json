    "companion",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@companion-module/base": "^1.12.0"
  },
  "devDependencies": {
    "@companion-module/tools": "2.7.2",
    "@types/node": "^20.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.4.0"
  },
  "prettier": "@companion-module/tools/.prettierrc.json"
}
